# Production equivalent of the Vite dev proxy (apps/web/vite.config.ts).
# Included inside nginx's http {} block, so map/log_format are allowed here.
# Known gotcha: nginx resolves ${API_UPSTREAM} once at startup. If the api container is recreated
# with a new IP, restart web (or use `resolver` + a variable in proxy_pass to re-resolve).
# In Kubernetes the Service's stable ClusterIP makes this a non-issue.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# The WebSocket JWT rides in the query string (ADR 0005). Log the path without it so tokens
# don't end up in access logs.
log_format no_query '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';

server {
    listen 8080;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # REST: /api/assets -> ${API_UPSTREAM}/assets (the trailing slash strips the /api prefix).
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket: HTTP/1.1 + Upgrade/Connection headers, and a long read timeout because the
    # server may go quiet (the default 60 s would cut idle sockets).
    location /ws/ {
        access_log /var/log/nginx/access.log no_query;
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
    }

    # Vite emits content-hashed filenames, so they can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback; index.html must never be cached or users keep stale bundles.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
